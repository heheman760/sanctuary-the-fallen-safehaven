extends Node2D

@onready var story_label = $HUD/Panel/Story
@onready var quest_label = $HUD/Panel/Quest
@onready var health_label = $HUD/Panel/Health
@onready var score_label = $HUD/Panel/Score
@onready var player = $Player
@onready var objective_label = $HUD/Panel/Objective

var story_index = 0
var total_kills = 0
var goal_kills = 5
var gate_open = false

var story_lines = [
    "The sanctuary of Sablemere has fallen beneath a silence no prayer can break.",
    "The city once sang beneath the Ashen Bell, but the bell was buried beneath the ruins after the night-walkers arrived.",
    "You are the last sworn keeper of the old oath. The dead still walk the shattered roads, and the abyss waits for your surrender.",
    "Break the siege on the ruined square, slay the husks of the fallen, and awaken the bell before the moon sets.",
    "The Ashen Bell is not a weapon. It is a vow — and the vow must be heard again."
]

func _ready():
    player.add_to_group("player")
    player.health_changed.connect(_on_player_health_changed)
    player.score_changed.connect(_on_score_changed)
    show_story()
    update_quest()

func _process(_delta):
    if Input.is_action_just_pressed("ui_accept"):
        show_story()

    var enemies_left = get_tree().get_nodes_in_group("enemies").size()
    if total_kills >= goal_kills and not gate_open:
        gate_open = true
        objective_label.text = "Objective: The Ember Gate is open. Ring the bell."
        quest_label.text = "Quest: Reach the bell tower and awaken the Ashen Bell."
        story_label.text = "The Ember Gate groans open. The old bell calls from beneath the sanctuary."

    if gate_open and enemies_left == 0:
        objective_label.text = "Objective: The sanctuary is restored."
        quest_label.text = "Quest Complete: The Ashen Bell has answered your vow."
        story_label.text = "The bell tolls once. The darkness stirs, but the dawn finally returns."

func show_story():
    if story_index < story_lines.size():
        story_label.text = story_lines[story_index]
        story_index += 1
    else:
        story_label.text = "The vow remains. The bell sleeps. Your hand is the only light left."

func update_quest():
    quest_label.text = "Quest: Defeat %d of %d wraiths in the ruins." % [total_kills, goal_kills]
    objective_label.text = "Objective: Clear the shattered square and protect the sanctuary."

func _on_player_health_changed(current, max_value):
    health_label.text = "Health: %d / %d" % [current, max_value]

func _on_score_changed(value):
    total_kills = value / 10
    score_label.text = "Score: %d" % [value]
    update_quest()
